# ============================================================
# Environment variables for Open-Set Face Recognition
# Copy to .env and fill in real values.
# ============================================================

# --- Application ---
APP_ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=open_set_fr
POSTGRES_USER=open_set_fr
POSTGRES_PASSWORD=change_me

# --- Models ---
# Recognition model version must match gallery embeddings (Rule 4)
GALLERY_MODEL_VERSION=w600k_r50@1.0.0
RECOGNITION_MODEL_PATH=models/recognition/w600k_r50.onnx

# --- Camera ---
CAMERA_SOURCE_TYPE=rtsp
CAMERA_ID=camera_01
CAMERA_URI=rtsp://admin:Nckh%402025@10.39.4.64:554/stream

# --- Auth (later phases, reserved) ---
# JWT_SECRET=change_me
# APP_BASE_URL=http://localhost
